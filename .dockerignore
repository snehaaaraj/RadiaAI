# Applies to builds whose context is the repository root (the frontend image, because
# vite.config.ts reads backend/app/VERSION). Send only what that build needs, so no
# .env file or backend source is ever uploaded.
*
!frontend
!backend/app/VERSION
frontend/node_modules
frontend/dist
frontend/coverage
frontend/.env
frontend/.env.*
!frontend/.env.example
!frontend/.env.production.example
frontend/*.tsbuildinfo
