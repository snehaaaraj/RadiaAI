# =============================================================================
# Radia AI - FRONTEND Environment Configuration (frontend/.env.example)
#
# Vite exposes only variables prefixed with VITE_ to browser code, and bakes
# them into the public bundle - never put secrets here (they belong in
# backend/.env.example). See frontend/.env.production.example for deployed
# builds.
#
# Copy this file to frontend/.env (or frontend/.env.local for per-machine
# overrides) and fill in the values you need for local development.
# =============================================================================

VITE_APP_NAME=Radia AI
VITE_APP_VERSION=0.1.0

# Backend API base URL. Leave as /api/v1 for local same-origin development
# (requests are proxied to VITE_DEV_PROXY_TARGET by Vite).
VITE_API_BASE_URL=/api/v1

# Local dev-only: Vite dev server proxy target for /api requests.
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Microsoft sign-in for the SPA (app registration separate from the backend's
# ENTRA_CLIENT_ID). Leave empty to skip sign-in locally (requires the backend
# to run with ENVIRONMENT=local or test).
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=api://<backend-entra-api-client-id>/access_as_user
VITE_ENTRA_REDIRECT_URI=
