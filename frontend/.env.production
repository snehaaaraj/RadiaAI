# Backend API base URL used by the frontend in production builds.
# Replace the placeholder below with your actual Azure App Service URL
# BEFORE running `npm run build` or triggering a Vercel redeploy.
# In Vercel, set this in Project Settings -> Environment Variables.
# Example: https://radia-ai-backend.azurewebsites.net/api/v1
VITE_API_BASE_URL=https://your-app-service-name.azurewebsites.net/api/v1
