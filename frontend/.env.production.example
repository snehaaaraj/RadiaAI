# =============================================================================
# Radia AI - FRONTEND Production Environment Configuration
# (frontend/.env.production.example)
#
# Full reference of every VITE_ variable used by the frontend build, tuned for
# a deployed (staging/production) build. Vite bakes these into the public
# bundle at build time - never put secrets here. Set the real values in your
# hosting provider's environment settings (e.g. Vercel Project Settings ->
# Environment Variables -> Production); do NOT commit a filled-in copy of
# this file. frontend/.env.production (checked in) carries only the
# non-sensitive defaults actually used by the current deployment.
#
# Backend (non-VITE_) variables are documented separately in
# backend/.env.example; for a deployed backend, set the production values
# directly in your hosting provider's environment variable settings.
# =============================================================================

VITE_APP_NAME=Radia AI
VITE_APP_VERSION=0.1.0

# Backend API base URL for the deployed build - must match your backend's
# public production URL, including the /api/v1 prefix.
VITE_API_BASE_URL=https://<your-backend-domain>/api/v1

# Not used in production builds (dev-server-only proxy target); omit or leave
# unset when deploying.
# VITE_DEV_PROXY_TARGET=

# Microsoft sign-in for the SPA (app registration separate from the backend's
# ENTRA_CLIENT_ID). Required for production sign-in.
VITE_ENTRA_CLIENT_ID=<your-entra-spa-app-client-id>
VITE_ENTRA_TENANT_ID=<your-entra-tenant-id>
VITE_ENTRA_API_SCOPE=api://<backend-entra-api-client-id>/access_as_user
VITE_ENTRA_REDIRECT_URI=https://<your-frontend-domain>
