{
  "name": "radia-jama",
  "displayName": "Radia MCP",
  "description": "Connect GitHub Copilot to Jama: read projects, requirements and relationships, and confirm field updates.",
  "version": "0.1.0",
  "publisher": "radiaai",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": ["AI", "Other"],
  "main": "./out/extension.js",
  "extensionKind": ["ui"],
  "activationEvents": ["onStartupFinished", "onMcpServerDefinitionProvider:radia-jama"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Radia starts a local MCP process with your Jama credentials; trust the workspace first."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "radiaJama.configure",
        "title": "Radia MCP: Connect or Update Account"
      },
      {
        "command": "radiaJama.disconnect",
        "title": "Radia MCP: Remove Saved Account"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "radia-jama",
        "label": "Radia MCP"
      }
    ],
    "configuration": {
      "title": "Radia MCP",
      "properties": {
        "radiaJama.uvPath": {
          "type": "string",
          "default": "uv",
          "scope": "application",
          "description": "UV executable name or absolute path. Install UV once, then run Radia MCP: Connect or Update Account. No shell command arguments."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test test/*.test.cjs",
    "vscode:prepublish": "node scripts/stage-server.cjs && npm run compile",
    "package": "vsce package --allow-missing-repository --skip-license --out ../dist/radia-jama-vscode-0.1.0.vsix"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "minimatch": "^11.0.9"
  }
}
