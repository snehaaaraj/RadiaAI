{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./out",
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node", "vscode"],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
