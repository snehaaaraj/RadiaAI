# =============================================================================
# mcp-radia - RadiaAI digital-thread MCP server
# =============================================================================
# Copy to `mcp-radia/.env` and fill in. This file is read ONLY by mcp-radia;
# it is separate from backend/.env on purpose so the two services can be
# deployed and credentialed independently.
#
#   cp mcp-radia/.env.example mcp-radia/.env
#
# `.env` is gitignored. Never commit real credentials.

# -----------------------------------------------------------------------------
# Server runtime
# -----------------------------------------------------------------------------
# One of: local | development | test | staging | production
# `local`/`development` render pretty console logs; everything else renders JSON.
MCP_RADIA_ENVIRONMENT=local

# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
MCP_RADIA_LOG_LEVEL=INFO

# HTTP transport only (`mcp-radia http`). Ignored under stdio.
# Port defaults to 8081 so it does not collide with the RadiaAI backend on 8000.
MCP_RADIA_HOST=127.0.0.1
MCP_RADIA_PORT=8081
MCP_RADIA_HTTP_PATH=/mcp

# -----------------------------------------------------------------------------
# Jama Connect (phase 1) - read-only
# -----------------------------------------------------------------------------
# Instance root URL, no /rest suffix. Leave empty to disable the integration:
# the jama_* tools stay listed but every call returns a "not configured" error.
JAMA_BASE_URL=

# "basic" or "oauth".
#   basic -> set JAMA_USERNAME / JAMA_PASSWORD. These may be a Jama user's
#            credentials, or a Jama Cloud API ID / API key pair.
#   oauth -> set JAMA_CLIENT_ID / JAMA_CLIENT_SECRET. The client-credentials
#            grant is exchanged at {JAMA_BASE_URL}/rest/oauth/token.
# Only the pair matching the chosen mode is required; the other is ignored.
JAMA_AUTH_TYPE=basic

JAMA_USERNAME=
JAMA_PASSWORD=

JAMA_CLIENT_ID=
JAMA_CLIENT_SECRET=

JAMA_API_VERSION=v1
JAMA_TIMEOUT_SECONDS=20
# Leave true. Only disable against a self-hosted test instance with a self-signed cert.
JAMA_VERIFY_SSL=true

# -----------------------------------------------------------------------------
# Atlassian Cloud - Jira + Confluence (phase 2) - read-only
# -----------------------------------------------------------------------------
# Jira and Confluence share ONE credential set: on Atlassian Cloud both products
# live under the same site and accept the same API token. The token belongs to a
# user account, so that account's product permissions decide what is readable.
# Prefer a dedicated service account over a person's credentials.
#
# Create a token at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
#
# Leave ATLASSIAN_SITE_URL empty to disable both integrations: the jira_* and
# confluence_* tools stay listed but every call returns a "not configured" error.

# Site root, no trailing path. Confluence is reached at {site}/wiki automatically.
ATLASSIAN_SITE_URL=

# The account email that owns the API token (used as the Basic auth username).
ATLASSIAN_EMAIL=

# The API token itself - NOT the account password.
ATLASSIAN_API_TOKEN=

ATLASSIAN_TIMEOUT_SECONDS=20
ATLASSIAN_VERIFY_SSL=true

# -----------------------------------------------------------------------------
# Vitech GENESYS - PLACEHOLDER, NOT IMPLEMENTED
# -----------------------------------------------------------------------------
# This is Vitech GENESYS, the MBSE tool now owned by Zuken. It is NOT Genesys
# Cloud CX, the contact-centre platform that shares the name.
#
# The connector is a placeholder: its REST contract could not be verified
# (Vitech's public API docs now redirect to Zuken marketing pages), so no
# GENESYS tools are registered and nothing below is read yet. The settings are
# parsed today so a .env written now stays valid once the connector is built.
#
# To implement: enable Swagger in AdminTools -> Configure REST API on the
# instance and build against the real contract.

GENESYS_BASE_URL=
GENESYS_API_BASE_PATH=api/v1

# "password" or "client_credentials".
GENESYS_GRANT_TYPE=password
GENESYS_USERNAME=
GENESYS_PASSWORD=
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=

GENESYS_TIMEOUT_SECONDS=30
# On-prem GENESYS often uses a self-signed certificate. Set false only if so.
GENESYS_VERIFY_SSL=true

# -----------------------------------------------------------------------------
# Cross-system linking (phase 4)
# -----------------------------------------------------------------------------
# No settings of its own. list_related_items reuses the connectors above, so it
# works for whichever systems are configured and says so in its "notes" field
# for the ones that are not.
