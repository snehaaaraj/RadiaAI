# =============================================================================
# mcp-radia - RadiaAI digital-thread MCP server
# =============================================================================
# Copy to `mcp-radia/.env` and fill in. This file is read ONLY by mcp-radia;
# it is separate from backend/.env on purpose so the two services can be
# deployed and credentialed independently.
#
#   cp mcp-radia/.env.example mcp-radia/.env
#
# `.env` is gitignored. Never commit real credentials.

# -----------------------------------------------------------------------------
# Server runtime
# -----------------------------------------------------------------------------
# One of: local | development | test | staging | production
# `local`/`development` render pretty console logs; everything else renders JSON.
MCP_RADIA_ENVIRONMENT=local

# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
MCP_RADIA_LOG_LEVEL=INFO

# HTTP transport only (`mcp-radia http`). Ignored under stdio.
# Port defaults to 8081 so it does not collide with the RadiaAI backend on 8000.
MCP_RADIA_HOST=127.0.0.1
MCP_RADIA_PORT=8081
MCP_RADIA_HTTP_PATH=/mcp

# -----------------------------------------------------------------------------
# Jama Connect (phase 1) - read-only
# -----------------------------------------------------------------------------
# Instance root URL, no /rest suffix. Leave empty to disable the integration:
# the jama_* tools stay listed but every call returns a "not configured" error.
JAMA_BASE_URL=

# "basic" or "oauth".
#   basic -> set JAMA_USERNAME / JAMA_PASSWORD. These may be a Jama user's
#            credentials, or a Jama Cloud API ID / API key pair.
#   oauth -> set JAMA_CLIENT_ID / JAMA_CLIENT_SECRET. The client-credentials
#            grant is exchanged at {JAMA_BASE_URL}/rest/oauth/token.
# Only the pair matching the chosen mode is required; the other is ignored.
JAMA_AUTH_TYPE=basic

JAMA_USERNAME=
JAMA_PASSWORD=

JAMA_CLIENT_ID=
JAMA_CLIENT_SECRET=

JAMA_API_VERSION=v1
JAMA_TIMEOUT_SECONDS=20
# Leave true. Only disable against a self-hosted test instance with a self-signed cert.
JAMA_VERIFY_SSL=true

# -----------------------------------------------------------------------------
# Jira / Confluence / Genesys
# -----------------------------------------------------------------------------
# Not implemented yet - phases 2 and 3.
