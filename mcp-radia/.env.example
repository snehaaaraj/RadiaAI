# =============================================================================
# mcp-radia - RadiaAI digital-thread MCP server
# =============================================================================
# Copy to `mcp-radia/.env` and fill in. This file is read ONLY by mcp-radia;
# it is separate from backend/.env on purpose so the two services can be
# deployed and credentialed independently.
#
#   cp mcp-radia/.env.example mcp-radia/.env
#
# `.env` is gitignored. Never commit real credentials.

# -----------------------------------------------------------------------------
# Server runtime
# -----------------------------------------------------------------------------
# One of: local | development | test | staging | production
# `local`/`development` render pretty console logs; everything else renders JSON.
MCP_RADIA_ENVIRONMENT=local

# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
MCP_RADIA_LOG_LEVEL=INFO

# HTTP transport only (`mcp-radia http`). Ignored under stdio.
# Port defaults to 8081 so it does not collide with the RadiaAI backend on 8000.
MCP_RADIA_HOST=127.0.0.1
MCP_RADIA_PORT=8081
MCP_RADIA_HTTP_PATH=/mcp

# -----------------------------------------------------------------------------
# Connector credentials
# -----------------------------------------------------------------------------
# None yet. Phase 0 is the scaffold and exposes no tools, so it needs no
# external credentials at all. Jama (phase 1), Jira + Confluence (phase 2) and
# Genesys (phase 3) each add their own block here as they land.
