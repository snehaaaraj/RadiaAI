# =============================================================================
# Radia AI - Environment Configuration
#
# Copy this file to .env and fill in your Azure resource values.
# NEVER commit .env to version control.
#
# Required for full operation: AZURE_OPENAI_*, AZURE_SEARCH_*, AZURE_BLOB_*
# Required for production auth: ENTRA_* (backend) and VITE_ENTRA_* (frontend)
# Required for SharePoint standards library: SHAREPOINT_*
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Required. Defaults to "production" when unset, which requires Entra ID (fail closed).
# Placeholder fallback settings and the local auth bypass are allowed only in local/test.
ENVIRONMENT=local                        # local | development | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=Radia AI
APP_VERSION=0.1.0

# CORS - comma-separated list of allowed origins
# Add your Vercel frontend domain(s) here
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","https://your-frontend-vercel-domain.vercel.app"]

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# RAG parameters (can be tuned per environment)
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_API_VERSION=2024-10-21

# Name of the deployed chat model (e.g., gpt-5, gpt-4-turbo)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5

# Faster non-reasoning deployment used specifically by the RAG document-Q&A
# chat endpoint/widget (latency-sensitive). Falls back to AZURE_OPENAI_CHAT_DEPLOYMENT
# if left unset.
AZURE_OPENAI_RAG_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_RAG_CHAT_MAX_TOKENS=1200

# Name of the deployed embedding model (e.g., text-embedding-3-large)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072

AZURE_OPENAI_MAX_TOKENS=4096
AZURE_OPENAI_TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# Azure AI Search
# ---------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=<your-azure-search-admin-key>
AZURE_SEARCH_INDEX_NAME=radia-documents
AZURE_SEARCH_SEMANTIC_CONFIG_NAME=radia-semantic-config

# ---------------------------------------------------------------------------
# Azure Blob Storage
# ---------------------------------------------------------------------------
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER_NAME=radia-documents

# Durable ingestion queue / upload limits
INGESTION_QUEUE_NAME=radia-ingestion
INGESTION_MAX_ATTEMPTS=5
INGESTION_MAX_UPLOAD_BYTES=4194304

# ---------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) - see docs/authentication.md
#
# Required in staging/production (the API refuses to start without it). In
# "development" every protected request fails closed with AUTH_NOT_CONFIGURED.
# Only ENVIRONMENT=local/test may leave these empty, which uses a synthetic
# local user with LOCAL_DEV_USER_ROLES.
#
# ENTRA_CLIENT_ID is the *API* app registration that exposes the
# "access_as_user" scope and defines the Radia.User / Radia.DocumentAdmin /
# Radia.Admin app roles.
# ---------------------------------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=                          # optional; defaults to api://<ENTRA_CLIENT_ID>
# Not used to validate API access tokens; normally leave unset.
ENTRA_CLIENT_SECRET=
ENTRA_REQUIRED_SCOPE=access_as_user
ENTRA_REQUIRE_APP_ROLE=true
ENTRA_ALLOW_APP_TOKENS=false
LOCAL_DEV_USER_ROLES=["Radia.Admin"]

# CORS regex for Vercel preview deployments. Leave empty when hosting internally
# so only ALLOWED_ORIGINS are trusted.
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# ---------------------------------------------------------------------------
# Frontend (Vite, build-time) - Microsoft sign-in for the SPA
# VITE_ENTRA_CLIENT_ID is the *SPA* app registration. Leave empty to skip
# sign-in (local development only).
# Set VITE_API_BASE_URL to the backend's public API root in deployed
# environments (e.g. https://your-backend.vercel.app/api/v1). Leave empty
# for local same-origin development.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=api://<api-client-id>/access_as_user
VITE_ENTRA_REDIRECT_URI=

# ---------------------------------------------------------------------------
# SharePoint Standards Library (Microsoft Graph API)
#
# Used to populate the Standards Library page with your real reference
# documents directly from SharePoint. Falls back to built-in registry
# entries when not configured.
#
# Setup steps:
#   1. portal.azure.com → Azure Active Directory → App registrations
#   2. New registration → name it e.g. "Radia AI Standards Reader"
#   3. API permissions → Microsoft Graph → Application → Sites.Read.All
#      → Grant admin consent
#   4. Certificates & secrets → New client secret → copy the Value
#   5. Overview → copy Application (client) ID and Directory (tenant) ID
#
# Leave all three credential fields empty to disable SharePoint and use
# the built-in standards registry instead.
# ---------------------------------------------------------------------------
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_URL=https://<your-tenant>.sharepoint.com/sites/<your-site>
SHAREPOINT_DRIVE_NAME=<Document Library Name>
SHAREPOINT_STANDARDS_FOLDER=<Path/To/Standards/Folder>
SHAREPOINT_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Skillz requirements-writing rules (authoritative, highest source authority)
#
# The Skillz package zip is read from the SharePoint drive above with the same
# credentials. Its rules govern the final recommendation synthesis for the
# listed requirement levels only. Other levels get a standards-only
# recommendation. Nothing in the package is executed.
# ---------------------------------------------------------------------------
SKILLZ_ENABLED=true
SKILLZ_ZIP_PATH=0. Reference Material/AI Reference Material/Skillz/acr-generator_Rev5.5_Issue1.0.zip
SKILLZ_APPLICABLE_LEVELS=aircraft
SKILLZ_CACHE_TTL_SECONDS=3600


# ---------------------------------------------------------------------------
# Jama Connect (REST API) - see docs/authentication.md
#
# Every Jama request runs as the signed-in user's *own* Jama account, so Jama
# enforces their project permissions. Each user links their account once in
# Settings -> Jama account with personal API credentials (Jama profile ->
# "Set API Credentials"). Those credentials are verified, encrypted with
# JAMA_CREDENTIAL_ENCRYPTION_KEY, and stored in JAMA_CREDENTIAL_CONTAINER_NAME.
#
# JAMA_BASE_URL      Instance root, e.g. https://yourorg.jamacloud.com
#                    (do NOT include the /rest suffix).
# JAMA_CREDENTIAL_ENCRYPTION_KEY
#                    Fernet key(s), comma-separated for rotation (first encrypts).
#                    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# JAMA_REQUIRE_EMAIL_MATCH
#                    Only link a Jama account whose email/username matches the
#                    Microsoft sign-in.
#
# Shared service account (LOCAL DEVELOPMENT ONLY - ignored unless
# ENVIRONMENT=local/test):
#   JAMA_AUTH_TYPE "basic" (JAMA_USERNAME / JAMA_PASSWORD) or
#   "oauth" (JAMA_CLIENT_ID / JAMA_CLIENT_SECRET).
#
# Leave JAMA_BASE_URL empty to disable the integration; the /jama endpoints then
# return JAMA_NOT_CONFIGURED.
# ---------------------------------------------------------------------------
JAMA_CREDENTIAL_ENCRYPTION_KEY=
JAMA_CREDENTIAL_CONTAINER_NAME=radia-user-secrets
JAMA_REQUIRE_EMAIL_MATCH=true
JAMA_BASE_URL=
JAMA_AUTH_TYPE=basic
# For local/test shared-account use only, choose one auth mode and configure its
# matching credentials below. Deployed users link their own Jama API credentials
# through Settings instead.
JAMA_USERNAME=
JAMA_PASSWORD=
JAMA_CLIENT_ID=
JAMA_CLIENT_SECRET=
JAMA_API_VERSION=v1
JAMA_TIMEOUT_SECONDS=20
JAMA_VERIFY_SSL=true


# Optional: auto-trigger ingestion via a Microsoft Graph change-notification
# webhook whenever documents in SHAREPOINT_STANDARDS_FOLDER are added, modified,
# or deleted - instead of relying only on the manual "Ingest Documents" button.
# Requires SHAREPOINT_* credentials above (Sites.Read.All is sufficient) and a
# stable public HTTPS base URL for this backend (e.g. your Vercel production URL).
SHAREPOINT_WEBHOOK_ENABLED=true
SHAREPOINT_WEBHOOK_PUBLIC_BASE_URL=https://<your-app>.vercel.app