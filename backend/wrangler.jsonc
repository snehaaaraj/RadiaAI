{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "radia-ai-backend",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    "DEBUG": false,
    "LOG_LEVEL": "INFO",
    "APP_NAME": "Radia AI",
    "APP_VERSION": "0.1.0",
    "ALLOWED_ORIGINS": [
      "https://radia-ai-gilt.vercel.app",
      "https://radia-ai-git-main-snehaaarajs-projects.vercel.app",
      "https://radia-rcicnfrfn-snehaaarajs-projects.vercel.app"
    ],
    "API_PREFIX": "/api/v1",
    "RETRIEVAL_TOP_K": 5,
    "CHUNK_SIZE": 512,
    "CHUNK_OVERLAP": 64,
    "AZURE_OPENAI_ENDPOINT": "https://radiaai-2-0-resource.services.ai.azure.com",
    "AZURE_OPENAI_API_VERSION": "2024-10-21",
    "AZURE_OPENAI_CHAT_DEPLOYMENT": "gpt-4o",
    "AZURE_OPENAI_EMBEDDING_DEPLOYMENT": "text-embedding-3-large",
    "AZURE_OPENAI_EMBEDDING_DIMENSIONS": 3072,
    "AZURE_OPENAI_MAX_TOKENS": 4096,
    "AZURE_OPENAI_TEMPERATURE": 0,
    "AZURE_SEARCH_ENDPOINT": "https://radia-ai-2-0-search.search.windows.net",
    "AZURE_SEARCH_INDEX_NAME": "radia-documents",
    "AZURE_SEARCH_SEMANTIC_CONFIG_NAME": "radia-semantic-config",
    "AZURE_BLOB_CONTAINER_NAME": "radia-documents",
    "ENTRA_TENANT_ID": "",
    "ENTRA_CLIENT_ID": "",
    "ENTRA_AUDIENCE": "",
    "SHAREPOINT_TENANT_ID": "",
    "SHAREPOINT_CLIENT_ID": "",
    "SHAREPOINT_SITE_URL": "https://<your-tenant>.sharepoint.com/sites/<your-site>",
    "SHAREPOINT_DRIVE_NAME": "<Document Library Name>",
    "SHAREPOINT_STANDARDS_FOLDER": "<Path/To/Standards/Folder>",
    "SHAREPOINT_CACHE_TTL_SECONDS": 300
  },
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "RadiaBackendContainer",
      "image": "./Dockerfile",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RADIA_BACKEND",
        "class_name": "RadiaBackendContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RadiaBackendContainer"
      ]
    }
  ]
}
