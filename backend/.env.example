# =============================================================================
# Radia AI - BACKEND Environment Configuration (backend/.env.example)
#
# Loaded by backend/app/core/config.py (pydantic-settings). Values here are
# read by the FastAPI backend only - frontend (Vite/VITE_*) variables live in
# frontend/.env.example and must never be duplicated here.
#
# Copy this file to backend/.env and fill in your Azure values for local
# development. For a deployed (staging/production) environment, set the real
# values directly in your hosting provider's environment variable settings
# (e.g. Vercel Project Settings -> Environment Variables) using this file as
# the reference for which variables exist - see the inline notes below for
# settings that typically differ in production (ENVIRONMENT, DEBUG,
# ALLOWED_ORIGINS, ENTRA_*, etc.).
#
# NEVER commit backend/.env (or any file with real secrets) to version control.
#
# Required for full operation: AZURE_OPENAI_*, AZURE_SEARCH_*, AZURE_BLOB_*
# Required for production auth: ENTRA_* (see docs/authentication.md)
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Defaults to "production" when unset, which requires Entra ID (fail closed).
# Placeholder fallback settings and the local auth bypass are allowed only in
# local/test. In a deployed environment, set ENVIRONMENT=staging or
# ENVIRONMENT=production instead.
ENVIRONMENT=local                        # local | development | test | staging | production
DEBUG=false                              # must stay false in production (enforced)
LOG_LEVEL=INFO
APP_NAME=Radia AI
APP_VERSION=0.1.0

# CORS - comma-separated/JSON list of allowed origins. Add your deployed
# frontend domain(s) here. In production, list only your real deployed
# frontend domain(s) - do not include localhost.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","https://your-frontend-domain.vercel.app"]

# CORS regex for preview deployments (e.g. Vercel). Leave empty when hosting
# internally so only ALLOWED_ORIGINS are trusted.
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# RAG parameters (can be tuned per environment)
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ---------------------------------------------------------------------------
# Ingestion (durable queue + upload limits)
# ---------------------------------------------------------------------------
INGESTION_QUEUE_NAME=radia-ingestion
INGESTION_MAX_ATTEMPTS=5
INGESTION_MAX_UPLOAD_BYTES=4194304

# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_API_VERSION=2024-10-21

# Name of the deployed chat model (e.g., gpt-5, gpt-4-turbo)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5

# Faster non-reasoning deployment used specifically by the RAG document-Q&A
# chat endpoint/widget (latency-sensitive). Falls back to
# AZURE_OPENAI_CHAT_DEPLOYMENT if left unset.
AZURE_OPENAI_RAG_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_RAG_CHAT_MAX_TOKENS=1200

# Name of the deployed embedding model (e.g., text-embedding-3-large)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072

AZURE_OPENAI_MAX_TOKENS=4096              # production commonly uses 16384 for GPT-5
AZURE_OPENAI_TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# Azure AI Search
# ---------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=<your-azure-search-admin-key>
AZURE_SEARCH_INDEX_NAME=radia-documents
AZURE_SEARCH_SEMANTIC_CONFIG_NAME=radia-semantic-config

# ---------------------------------------------------------------------------
# Azure Blob Storage
# ---------------------------------------------------------------------------
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER_NAME=radia-documents

# ---------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) - see docs/authentication.md
#
# Required in staging/production (the API refuses to start without it). In
# "development" every protected request fails closed with AUTH_NOT_CONFIGURED.
# Only ENVIRONMENT=local/test may leave these empty, which uses a synthetic
# local user with LOCAL_DEV_USER_ROLES.
#
# ENTRA_CLIENT_ID is the *API* app registration that exposes the
# "access_as_user" scope and defines the Radia.User / Radia.Admin app roles.
# ---------------------------------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=                          # optional; defaults to api://<ENTRA_CLIENT_ID>
# Not used to validate API access tokens; normally leave unset.
ENTRA_CLIENT_SECRET=
ENTRA_REQUIRED_SCOPE=access_as_user
ENTRA_REQUIRE_APP_ROLE=true
ENTRA_ALLOW_APP_TOKENS=false
# Optional tuning (sensible defaults shown; uncomment to override):
# ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
# ENTRA_CLOCK_SKEW_SECONDS=120
# ENTRA_JWKS_CACHE_TTL_SECONDS=3600
# ENTRA_HTTP_TIMEOUT_SECONDS=10

# App roles granted to the synthetic user used only when ENVIRONMENT is
# local/test and Entra ID is not configured.
LOCAL_DEV_USER_ROLES=["Radia.Admin"]

# ---------------------------------------------------------------------------
# SharePoint Standards Library (Microsoft Graph API)
# App registration must have: Sites.Read.All (application permission)
#
# Setup steps:
#   1. portal.azure.com -> Azure Active Directory -> App registrations
#   2. New registration -> name it e.g. "Radia AI Standards Reader"
#   3. API permissions -> Microsoft Graph -> Application -> Sites.Read.All
#      -> Grant admin consent
#   4. Certificates & secrets -> New client secret -> copy the Value
#   5. Overview -> copy Application (client) ID and Directory (tenant) ID
#
# Leave all three credential fields empty to disable SharePoint and use the
# built-in standards registry instead.
# ---------------------------------------------------------------------------
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_URL=https://<your-tenant>.sharepoint.com/sites/<your-site>
SHAREPOINT_DRIVE_NAME=<Document Library Name>
SHAREPOINT_STANDARDS_FOLDER=<Path/To/Standards/Folder>
SHAREPOINT_CACHE_TTL_SECONDS=300

# Optional: auto-trigger ingestion via a Microsoft Graph change-notification
# webhook whenever documents in SHAREPOINT_STANDARDS_FOLDER are added,
# modified, or deleted - instead of relying only on the manual "Ingest
# Documents" button. Requires SHAREPOINT_* credentials above (Sites.Read.All
# is sufficient) and a stable public HTTPS base URL for this backend.
SHAREPOINT_WEBHOOK_ENABLED=false
SHAREPOINT_WEBHOOK_PUBLIC_BASE_URL=https://<your-app-domain>

# ---------------------------------------------------------------------------
# Skillz requirements-writing rules (authoritative, highest source authority)
#
# The Skillz package zip is read from the SharePoint drive above with the same
# credentials. Its rules govern the final recommendation synthesis for the
# listed requirement levels only. Other levels get a standards-only
# recommendation. Nothing in the package is executed.
# ---------------------------------------------------------------------------
SKILLZ_ENABLED=true
SKILLZ_ZIP_PATH=0. Reference Material/AI Reference Material/Skillz/acr-generator_Rev5.5_Issue1.0.zip
SKILLZ_APPLICABLE_LEVELS=aircraft
SKILLZ_CACHE_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Jama Connect (REST API) - see docs/authentication.md
#
# Every Jama request runs as the signed-in user's *own* Jama account, so Jama
# enforces their project permissions. Each user links their account once in
# Settings -> Jama account with personal API credentials (Jama profile ->
# "Set API Credentials"). Those credentials are verified, encrypted with
# JAMA_CREDENTIAL_ENCRYPTION_KEY, and stored in JAMA_CREDENTIAL_CONTAINER_NAME.
#
# JAMA_BASE_URL      Instance root, e.g. https://yourorg.jamacloud.com
#                    (do NOT include the /rest suffix).
# JAMA_CREDENTIAL_ENCRYPTION_KEY
#                    Fernet key(s), comma-separated for rotation (first encrypts).
#                    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# JAMA_REQUIRE_EMAIL_MATCH
#                    Only link a Jama account whose email/username matches the
#                    Microsoft sign-in.
#
# Shared service account (LOCAL DEVELOPMENT ONLY - ignored unless
# ENVIRONMENT=local/test):
#   JAMA_AUTH_TYPE "basic" (JAMA_USERNAME / JAMA_PASSWORD) or
#   "oauth" (JAMA_CLIENT_ID / JAMA_CLIENT_SECRET).
#
# Leave JAMA_BASE_URL empty to disable the integration; the /jama endpoints
# then return JAMA_NOT_CONFIGURED.
# ---------------------------------------------------------------------------
JAMA_CREDENTIAL_ENCRYPTION_KEY=
JAMA_CREDENTIAL_CONTAINER_NAME=radia-user-secrets
JAMA_REQUIRE_EMAIL_MATCH=true
JAMA_BASE_URL=
JAMA_AUTH_TYPE=basic
# For local/test shared-account use only, choose one auth mode and configure
# its matching credentials below. Deployed users link their own Jama API
# credentials through Settings instead.
JAMA_USERNAME=
JAMA_PASSWORD=
JAMA_CLIENT_ID=
JAMA_CLIENT_SECRET=
JAMA_API_VERSION=v1
JAMA_TIMEOUT_SECONDS=20
JAMA_VERIFY_SSL=true

# ---------------------------------------------------------------------------
# MCP (Model Context Protocol) chat integration - OPTIONAL, disabled by default.
# ---------------------------------------------------------------------------
# Lets chat call read-only tools (Jama today) on a separately deployed
# mcp-radia server. See docs/architecture.md section 10.1 for the full
# request flow, identity model, and deployment/rollback walkthrough.
#
# Leave MCP_ENABLED=false (or MCP_SERVER_URL/MCP_SERVICE_TOKEN empty) to keep
# chat exactly as it behaves today - nothing else needs to change.
MCP_ENABLED=false

# mcp-radia's Streamable HTTP endpoint, e.g. http://127.0.0.1:8081/mcp locally,
# an internal Container Apps URL in a production deployment, or a Vercel demo
# deployment's URL (e.g. https://mcp-radia-yourname.vercel.app/mcp - see
# docs/architecture.md section 11 for the security tradeoff that path accepts).
MCP_SERVER_URL=

# Shared bearer token presented to mcp-radia on every request. Must match
# mcp-radia's own MCP_RADIA_SERVICE_TOKEN exactly. Generate with e.g.
# `openssl rand -hex 32`. Never commit a real value.
MCP_SERVICE_TOKEN=

MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_READ_TIMEOUT_SECONDS=20
# Upper bound on sequential tool calls, and overall deadline, for one chat turn.
MCP_MAX_TOOL_ITERATIONS=3
MCP_MAX_TOTAL_SECONDS=25
MCP_MAX_RESPONSE_BYTES=32000

# Server-side allowlist: a tool mcp-radia advertises but that is not listed
# here is never offered to the model and never executed. Jira/Confluence/
# linking tools are intentionally excluded while per-user Atlassian linking
# remains on hold.
MCP_ALLOWED_TOOLS=jama_get_item,jama_search,jama_get_children,jama_list_projects
